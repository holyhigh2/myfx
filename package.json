{
  "name": "myfx",
  "version": "2.0.0-beta.1",
  "description": "A modular utility library with more utils, higher performance and simpler declarations ...",
  "main": "dist/index.umd.js",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.mjs",
      "require": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".agents",
    "llms.txt"
  ],
  "author": "holyhigh2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/holyhigh2/myfx"
  },
  "bugs": "https://github.com/holyhigh2/myfx/issues/new",
  "homepage": "https://holyhigh2.github.io/myfx/",
  "keywords": [
    "lib",
    "utils",
    "functions",
    "modular",
    "stdlib"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "node ./config/build.chainfx.mjs && vite build && vite build --mode umd",
    "jest": "jest --no-cache --verbose",
    "dev": "vite build --watch --mode dev",
    "doc": "node extract-docs.js",
    "pack-test": "npm pack --dry-run"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.1",
    "@types/jest": "^29.0.0",
    "eslint-plugin-tsdoc": "^0.2.17",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.0.1",
    "ts-jest": "^29.2.5",
    "ts-morph": "^21.0.1",
    "tslib": "^2.4.1",
    "typedoc": "^0.25.1",
    "typedoc-plugin-markdown": "^3.14.0",
    "typescript": "^5.2.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1"
  }
}